{
  "name": "@reveal/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 5173",
    "dev:mock": "NEXT_PUBLIC_TRANSPORT=mock next dev -H 0.0.0.0 -p 5173",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:mock": "npx -y tsx --tsconfig scripts/tsconfig.test.json scripts/mock-flow.test.ts",
    "test:ssr": "npx -y tsx --tsconfig scripts/tsconfig.test.json scripts/ssr-smoke.test.ts",
    "test": "npm run typecheck && npm run test:ssr",
    "test:live": "node scripts/live-socket-smoke.mjs"
  },
  "dependencies": {
    "canvas-confetti": "1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "next": "15.5.28",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3"
  }
}
