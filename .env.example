# Reveal Game — environment. Copy to `.env` and fill in what you have.
# EVERYTHING here is optional: with no keys at all the game runs the whole
# night on the handwritten prompt bank, fully offline after `npm install`.

# --- Hosting (npm run host) ---
# 0.0.0.0 = every interface, so phones on your WiFi / hotspot can join.
HOST=0.0.0.0
PORT=3001

# --- Prompt generation: local Ollama on the host laptop (no key needed) ---
# Install Ollama, then run: ollama pull dolphin-mistral
# The Node server (not players' phones) connects to this endpoint.
# Service unavailable / model missing → handwritten bank prompts keep playing.
GEN_BASE=http://localhost:11434/v1
GEN_MODEL=dolphin-mistral

# Existing cloud reveal lane only; optional and unchanged.
XAI_API_KEY=

# --- Lane 2: Gemini — data analysis only ---
# Key: aistudio.google.com/apikey. Used for bounded debrief-pair/tag analysis.
# Gemini never receives reveal/secret narration requests. Leave empty → deterministic code analysis
# (token-Jaccard + lexicon) and template finale slides.
GEMINI_API_KEY=

# Optional model overrides
# XAI_MODEL=  # legacy model override; GEN_MODEL takes precedence for generation
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Reveal pacing (optional, DEFAULT-OFF) ---
# "round"  = every round closes into its own reveal (today's game).
# "finale" = per-round reveals are suppressed and queued; the whole night's
#            reveal reel plays on the public DISPLAY at the finale (phones never
#            see it, and the phone finale is identical). An unset or misspelt
#            value means "round" — a bad env line can never change a night.
REVEAL_MODE=round
