# The Reveal Game — environment
#
# Copy to `.env` and edit. Everything here is optional: the game runs fully
# offline on the hand-written prompt bank.

# ---------------------------------------------------------------------------
# The Ollama lane — the local model that writes the night's questions and
# dares. This is the only generator, and it is handed the room's REAL NAMES
# (it runs on this machine, and the questions are about these people).
# ---------------------------------------------------------------------------
# Where your Ollama server is running.
GEN_BASE=http://127.0.0.1:11434
# The model to use. `ollama pull dolphin-mistral` once, then it works offline.
GEN_MODEL=dolphin-mistral
# How long to wait for the model, in milliseconds. Local models are slow.
GEN_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Gemini — the analyst. At the end of the night it gets the whole pseudonymised
# result set and writes the reveal and the secret-card copy. It never writes a
# question. Optional: without a key the game narrates itself, from the data.
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Gameplay
# ---------------------------------------------------------------------------
# The port the game server listens on.
PORT=3001
# The interface to bind. 0.0.0.0 lets phones on the same Wi-Fi join.
HOST=0.0.0.0
