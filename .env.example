# Reveal Game — environment. Copy to `.env` and fill in what you have.
# EVERYTHING here is optional: with no keys at all the game runs the whole
# night on the handwritten prompt bank, fully offline after `npm install`.

# --- Hosting (npm run host) ---
# 0.0.0.0 = every interface, so phones on your WiFi / hotspot can join.
HOST=0.0.0.0
PORT=3001

# --- Lane 1: Grok (xAI) — unhinged prompt generation ---
# Key: console.x.ai → API Keys. Model grok-4-1-fast ≈ $0.20/$0.50 per 1M
# tokens; a whole night of batched generation costs well under $0.02.
# Leave empty → bank prompts only.
XAI_API_KEY=

# --- Lane 2: Gemini — data analysis + finale narration (higher tier) ---
# Key: aistudio.google.com/apikey. Uses gemini-3.1-pro for debrief-pair
# analysis and the finale story. Leave empty → deterministic code analysis
# (token-Jaccard + lexicon) and template finale slides.
GEMINI_API_KEY=
