{
  "name": "reveal-game",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "host": "npm run build && node host.mjs",
    "start": "node host.mjs",
    "build": "node scripts/build.mjs",
    "bundle:check": "node scripts/check-bundle.mjs",
    "selfcheck": "npx -y tsx scripts/selfcheck.ts",
    "smoke": "npx tsx scripts/bots.ts",
    "smoke:demo": "npx tsx scripts/demo-smoke.ts",
    "typecheck": "node scripts/typecheck.mjs",
    "smoke:oracle": "node scripts/smoke-with-oracle.mjs",
    "smoke:verified": "tsx scripts/verified-smoke.ts",
    "measure:sparks": "tsx scripts/spark-incidence.ts",
    "test:components": "tsx --tsconfig apps/web/scripts/tsconfig.test.json scripts/test-components.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "jsdom": "^26.1.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.32"
    }
  }
}
